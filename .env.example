# ============================================================================
# KickPredict Africa — variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs.
# ============================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (https://supabase.com -> Project Settings -> API) ---
# Authentification par email + code OTP (service d'email intégré à Supabase, gratuit,
# aucun fournisseur SMS/Twilio nécessaire). Voir docs/10-sms-otp-setup.md pour augmenter
# le volume d'envoi plus tard (SMTP personnalisé).
NEXT_PUBLIC_SUPABASE_URL=https://TON_PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle_anon_publique
SUPABASE_SERVICE_ROLE_KEY=cle_service_role_SECRETE_ne_jamais_exposer_au_client

# --- Paiement ---
# "manual"   : l'utilisateur envoie l'argent à la main sur un numéro marchand puis déclare son
#              paiement ; un admin valide depuis /admin (mode par défaut, le temps d'activer un
#              compte marchand CinetPay).
# "cinetpay" : paiement automatisé via CinetPay (voir bloc ci-dessous).
PAYMENTS_PROVIDER=manual
NEXT_PUBLIC_MANUAL_TMONEY_NUMBER=90 00 00 00
NEXT_PUBLIC_MANUAL_FLOOZ_NUMBER=99 00 00 00
NEXT_PUBLIC_MANUAL_PAYMENT_HOLDER=KickPredict
NEXT_PUBLIC_MANUAL_WHATSAPP_NUMBER=22890000000

# --- Liens d'affiliation bookmakers (facultatif) ---
# Chaque pronostic propose un raccourci vers ces bookmakers (bouton "Parier sur ce match").
# Important : aucun bookmaker n'offre d'API publique pour créer un coupon pré-rempli
# automatiquement — on copie le résumé du pronostic dans le presse-papier puis on ouvre le
# site du bookmaker (son lien d'affiliation ci-dessous si renseigné, sinon sa page publique).
# Laisse vide pour utiliser l'URL publique par défaut (voir lib/bookmakers.ts).
NEXT_PUBLIC_BOOKMAKER_1XBET_URL=
NEXT_PUBLIC_BOOKMAKER_BETWINNER_URL=
NEXT_PUBLIC_BOOKMAKER_MELBET_URL=
NEXT_PUBLIC_BOOKMAKER_SPORTYBET_URL=
NEXT_PUBLIC_BOOKMAKER_PREMIERBET_URL=
NEXT_PUBLIC_BOOKMAKER_22BET_URL=
NEXT_PUBLIC_BOOKMAKER_PARIMATCH_URL=
NEXT_PUBLIC_BOOKMAKER_LINEBET_URL=
NEXT_PUBLIC_BOOKMAKER_MOZZART_URL=
NEXT_PUBLIC_BOOKMAKER_BET9JA_URL=

# --- CinetPay (https://cinetpay.com -> Compte -> API) — à activer avec PAYMENTS_PROVIDER=cinetpay ---
# Priorité absolue : Mobile Money Togo (T-Money / Mixx by Yas, Flooz / Moov Africa)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# --- API-Football / API-SPORTS (https://www.api-football.com) ---
# La synchronisation (app/api/predictions/sync-fixtures) récupère DÉSORMAIS tous les matchs
# toutes compétitions confondues (~1200 ligues couvertes par API-Football, le même univers que
# les bookmakers comme 1xBet) au lieu d'une liste figée de championnats. Le plan gratuit
# (100 requêtes/jour) suffit pour les matchs eux-mêmes (1 requête/jour par journée couverte),
# mais les cotes réelles sont limitées à MAX_ODDS matchs (1 requête/match) pour rester dans ce
# quota — augmente ces valeurs si tu passes à un plan payant (plus de requêtes/jour).
API_FOOTBALL_KEY=
API_FOOTBALL_MAX_FIXTURES=500
# Nombre de matchs enrichis en détail (cotes 1X2+O/U+BTTS, H2H, blessures, classement/enjeu) par
# exécution de sync-fixtures : 3 appels API par match enrichi + 1 appel /standings par ligue
# concernée + 3 appels /fixtures (hier/aujourd'hui/demain). Avec le plan gratuit API-Football
# (100 requêtes/jour), 20 est un bon compromis ; augmente si ton plan a plus de quota.
API_FOOTBALL_MAX_ENRICHED=20

# --- Telegram Bot (https://t.me/BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Business Cloud API (Meta) — pour les alertes premium ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Sécurité des tâches planifiées (Vercel Cron) ---
# Vercel ajoute automatiquement l'en-tête "Authorization: Bearer $CRON_SECRET"
# quand cette variable est définie dans le projet.
CRON_SECRET=change_moi_en_valeur_aleatoire_longue

# --- IA générative (optionnel, pour enrichir les explications en langage naturel) ---
OPENAI_API_KEY=
